# CGMS environment template
#
# Copy this file to a secure environment-specific configuration source.
# Never commit a populated .env file, passwords, tokens, private keys,
# certificates, cookies, JWTs or production database URLs.

APP_NAME=CGMS

# Canonical values: development, test, staging, production.
# Unknown or misspelled values fail closed.
ENVIRONMENT=development

# Application settings
DEBUG=false

# External services
TELEGRAM_BOT_TOKEN=replace_with_a_real_token_outside_version_control
OPENAI_API_KEY=replace_with_a_real_key_outside_version_control

# Database
# Local development example only. Use a managed secret in staging/production.
DATABASE_URL=postgresql+psycopg://cgms_user:cgms_password@localhost:5432/cgms

# CAP-005 governed database backup and recovery
# Backup source database. Supply through the approved secret mechanism.
CGMS_BACKUP_DATABASE_URL=

# Explicit restore target. Never default restore operations to DATABASE_URL
# or to CGMS_BACKUP_DATABASE_URL.
CGMS_RESTORE_DATABASE_URL=

# AES-256-GCM key: URL-safe base64 encoding of exactly 32 random bytes.
# Store the real key only in the approved secret manager; never commit it.
CGMS_BACKUP_ENCRYPTION_KEY=

# Runtime hardening
# SQL statement echo defaults to false and cannot be enabled in
# staging or production.
CGMS_SQL_ECHO=false

# Development/test may use warn. Staging/production require strict.
CGMS_DATABASE_STARTUP_POLICY=warn

# Authentication and signed access tokens
# Use a cryptographically random value of at least 32 characters.
CGMS_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
CGMS_JWT_EXPIRE_MINUTES=1440
CGMS_JWT_ISSUER=cgms
CGMS_JWT_AUDIENCE=cgms-dashboard

# Secure browser session
# Cookie names must retain the __Host- prefix.
CGMS_SESSION_COOKIE_NAME=__Host-cgms_session
CGMS_SESSION_EXPIRE_MINUTES=30

# Signed browser CSRF token
CGMS_CSRF_COOKIE_NAME=__Host-cgms_csrf
CGMS_CSRF_EXPIRE_SECONDS=600

# Comma-separated exact origins permitted to make credentialed
# cross-origin browser requests. Leave blank for same-origin access only.
# Production origins must use HTTPS and must not include paths,
# credentials, query strings, fragments or wildcards.
# Example:
# CGMS_ALLOWED_ORIGINS=https://portal.example.com
CGMS_ALLOWED_ORIGINS=

# Persistent browser-login throttling
# A dedicated random secret is recommended. When blank, CGMS_JWT_SECRET
# is used as the input to a domain-separated HMAC derivation.
CGMS_LOGIN_THROTTLE_SECRET=
CGMS_LOGIN_THROTTLE_WINDOW_SECONDS=900
CGMS_LOGIN_THROTTLE_PAIR_LIMIT=5
CGMS_LOGIN_THROTTLE_NETWORK_LIMIT=25
CGMS_LOGIN_THROTTLE_BLOCK_SECONDS=900
CGMS_LOGIN_THROTTLE_RETENTION_DAYS=7

# Comma-separated CIDR ranges for reverse proxies that CGMS may trust
# when resolving forwarded client addresses. Leave blank when CGMS is
# directly exposed or when proxy trust has not been explicitly designed.
# Example:
# CGMS_TRUSTED_PROXY_CIDRS=10.10.0.0/16,2001:db8:1234::/48
CGMS_TRUSTED_PROXY_CIDRS=
